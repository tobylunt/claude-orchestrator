# Bob runtime image — copy this to `bob.dockerfile` in your project root and Bob
# will auto-detect and build from it when invoked with --sandbox docker.
#
# This image is used as the sandbox for McLoop iterations (real `claude -p`
# subprocesses) so we need:
#   1. Node.js (claude CLI runtime)
#   2. The claude CLI itself
#   3. git (for worktree operations)
#   4. Whatever language toolchain your project uses
#
# IMPORTANT: claude inside the container needs access to your Anthropic auth.
# DockerExecutor forwards ANTHROPIC_API_KEY / OPENAI_API_KEY from the host
# environment automatically (M9). If you sign in via `claude` CLI sessions
# rather than API keys, mount your config instead:
#
#   BOB_DOCKER_EXTRA_ARGS='-v $HOME/.claude:/root/.claude:ro' bob run ...

FROM python:3.10-slim

# Base tooling. `jq` is needed because some claude tool-use paths shell out
# to it inside the container; without it those calls fail silently.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (claude CLI runtime)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install the Claude Code CLI (or pin a specific version)
RUN npm install -g @anthropic-ai/claude-code

# Project-specific Python deps — uncomment + add a requirements.txt to
# your project root when ready. Leaving these commented avoids the
# "COPY: requirements.txt not found" build failure that fires when the
# file doesn't exist (Docker COPY does not support optional files).
#
# COPY requirements.txt /tmp/requirements.txt
# RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Set up a non-root user for safer execution
RUN useradd -m -s /bin/bash bob
USER bob

WORKDIR /workspace
