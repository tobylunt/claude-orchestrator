# Bob configuration template
# Copy this to `.env` somewhere Bob loads from and fill in the values.
# IMPORTANT: never commit `.env` to version control.
#
# Bob loads .env files automatically when invoked. Loading precedence
# (highest priority first):
#   1. Process environment (always wins)
#   2. <project_root>/.env  (where you point --project)
#   3. <cwd>/.env           (where you run `bob`)
#   4. ~/.bob/.env          (user-level — recommended for API keys you reuse
#                            across projects)
#
# Recommended setup: put API keys in `~/.bob/.env` once; put project-specific
# overrides (model selection, sandbox tier, etc.) in the project's `.env`.


# ── API keys ──────────────────────────────────────────────────────────
# Required for real Orchestra (Claude vs Codex debate), real multimodal
# Duplo, real Vroom auditors. Without these, set BOB_USE_STUB_* below.

ANTHROPIC_API_KEY=sk-ant-…
OPENAI_API_KEY=sk-…


# ── Stub modes (uncomment to skip API calls) ──────────────────────────
# Useful for testing the orchestration without burning tokens.

# BOB_USE_STUB_ORCHESTRA=1   # auto-approve verdicts; no Claude/Codex debate
# BOB_USE_STUB_VROOM=1       # Claude+Codex auditors return empty findings
# BOB_USE_STUB_DUPLO=1       # markdown-only Duplo (no vision)


# ── Model selection (defaults are sensible — only override to experiment) ──

# BOB_DUPLO_MODEL=claude-opus-4-7
# BOB_MCLOOP_MODEL=claude-sonnet-4-6
# BOB_ORCHESTRA_CLAUDE_MODEL=claude-sonnet-4-6
# BOB_ORCHESTRA_CODEX_MODEL=gpt-5.4
# BOB_ORCHESTRA_CODEX_EFFORT=medium   # none|low|medium|high|xhigh|default
# BOB_ORCHESTRA_FAST_JUDGE_MODEL=claude-sonnet-4-6
# BOB_ORCHESTRA_PREMIUM_POLICY=adaptive     # adaptive|always|never
# BOB_ORCHESTRA_PREMIUM_MIN_CONFIDENCE=0.85
# BOB_ORCHESTRA_PREMIUM_DIFF_BYTES=12000
# BOB_ORCHESTRA_PREMIUM_FILE_COUNT=8
# BOB_ORCHESTRA_PREMIUM_RISK_FRAGMENTS=auth,oauth,login,security,secret,token,payment,billing,sandbox,docker
# BOB_ORCHESTRA_PREMIUM_CODEX_MODEL=gpt-5.5
# BOB_ORCHESTRA_PREMIUM_CODEX_EFFORT=xhigh
# BOB_ORCHESTRA_JUDGE_MODEL=claude-opus-4-7   # premium final judge
# BOB_ORCHESTRA_MAX_ROUNDS=5
# BOB_VROOM_CLAUDE_MODEL=claude-sonnet-4-6
# BOB_VROOM_CODEX_MODEL=gpt-5.4
# BOB_VROOM_CODEX_EFFORT=low          # continuous audit default; use xhigh for deep sweeps


# ── Sandbox configuration ─────────────────────────────────────────────
# Tier 1 (host)         — default; uses bob/hooks for safety
# Tier 2 (docker)       — required for YOLO; needs Docker daemon running.
#                         Auto-detects `bob.dockerfile` in your project root
#                         (see bob.dockerfile.example in the bob repo).
# Tier 3 (devcontainer) — also OK for YOLO; needs `devcontainer` CLI

# BOB_SANDBOX_TIER=docker
# BOB_DOCKER_IMAGE=python:3.10-slim
# BOB_DOCKER_CPUS=4
# BOB_DOCKER_MEMORY=8g
# BOB_DOCKER_NETWORK=bob-allowlist        # custom Docker network for egress filtering
# BOB_DOCKER_ALLOWLIST=1                  # apply default --add-host entries


# ── YOLO mode ─────────────────────────────────────────────────────────
# Single-flag opt-in for unattended runs. Requires Tier 2+ sandbox and
# --max-cost. See spec §6.9 for documented downstream effects.

# BOB_YOLO_MAX_INCONCLUSIVE=3       # halt after N consecutive Inconclusives
# BOB_YOLO_VROOM_SEVERITY=high      # auto-approve Vroom triage at/above this severity
# BOB_YOLO_NOTIFY=                  # email/slack/desktop notification (M6)


# ── Observability ─────────────────────────────────────────────────────
# Bob ships OpenTelemetry instrumentation. Configure an OTLP-compatible
# backend (e.g., Phoenix at http://localhost:6006/v1/traces) to see traces.

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces


# ── Billing mode (subscription vs api) ───────────────────────────────
# Default: subscription. Use `api` for pay-as-you-go usage tracking.

# BOB_ANTHROPIC_BILLING=subscription
# BOB_OPENAI_BILLING=subscription
