{
  "$defs": {
    "Provider": {
      "description": "Where a SourceReference came from.\n\nThe MVP emits only :attr:`LOCAL_FILES`. Other variants exist so the same\nClaim/SourceReference records can later represent git, GitHub, Google Drive,\nNotion, and other org systems without a schema rewrite.",
      "enum": [
        "local_files",
        "git_history",
        "github",
        "gdrive",
        "notion",
        "other"
      ],
      "title": "Provider",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A provider-aware pointer back to the evidence behind a Claim.\n\n``uri`` is the canonical locator within the provider's namespace:\n  - ``local_files``: a normalized relative path (or ``file://`` URI) under\n    the crawl root. No top-level \"path\" field — keep everything in ``uri``\n    so non-file providers don't need a special case.\n  - ``git_history``: a path within the repo; ``revision`` carries the\n    commit sha.\n  - ``github``/``gdrive``/``notion``: provider-native URLs or IDs.\n\nSpan fields are all optional because different providers expose different\naddressing granularity (line spans for code, page for PDFs, block for\nNotion).",
      "properties": {
        "block": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "provider",
        "uri",
        "observed_at"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "Status": {
      "description": "Lifecycle status of a Claim.",
      "enum": [
        "proposed",
        "verified",
        "conflict",
        "stale",
        "ruled_out",
        "needs_human"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A single cited fact about the organization.\n\nHard invariants enforced here:\n  - ``source_references`` is non-empty (no claim without provenance).\n  - ``confidence`` is in ``[0, 1]``.\n  - ``status`` must be one of the declared :class:`Status` values.\n\nOther invariants (e.g. local-file spans resolving to real bytes, ownership\nclaims carrying explicit evidence) are enforced by downstream verifiers\nrather than the schema itself.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "related_owners": {
      "items": {
        "type": "string"
      },
      "title": "Related Owners",
      "type": "array"
    },
    "related_systems": {
      "items": {
        "type": "string"
      },
      "title": "Related Systems",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "Source References",
      "type": "array"
    },
    "source_type": {
      "minLength": 1,
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "text",
    "source_references",
    "source_type",
    "observed_at",
    "confidence",
    "status"
  ],
  "title": "Claim",
  "type": "object"
}
